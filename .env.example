# Copy to .env  — secrets only. Everything else lives in config/settings.json
# (editable from the Setup page at http://localhost:8010).

# Required when any LLM role is set to "openrouter" (the default)
OPENROUTER_API_KEY=

# Optional: key for an OpenAI-compatible endpoint (llama.cpp / LM Studio need none; Groq, Together, OpenAI do)
OPENAI_COMPAT_API_KEY=

# Optional: shared secret for speech services running on another machine (see distributed/README.md)
SAKURA_SERVICE_TOKEN=

# Only needed for Discord mode
DISCORD_BOT_TOKEN=
